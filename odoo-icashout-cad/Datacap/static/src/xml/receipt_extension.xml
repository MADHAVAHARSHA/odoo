<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('before-footer')]" t-operation="before">
            <div class="paymentlines text-start" t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                <t t-if="line.receipt_lines">
                    <t t-set="lines" t-value="line.receipt_lines.split('\n')"/>
                    <t t-foreach="lines" t-as="row" t-key="row_index">
                        <center>
                            <div>
                                <t t-esc="row.replaceAll('.', ' ').trim()"/>
                            </div>
                        </center>
                    </t>
                </t>
                <t t-if="line.card_no">
                    <div class="ms-2 text-center">
                        [<t t-esc="line.card_no"/>]
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
