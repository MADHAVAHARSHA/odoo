<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="TicketScreen-void-button" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[@class='control-buttons d-flex gap-2 pb-2']" position="inside">
            <button class="control-button btn btn-light btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-on-click="() => this.voidTransaction()"
                        t-att-disabled="state.voidButtonDisabled">
                    <i class="fa fa-times-circle me-1"/> Void
            </button>
        </xpath>
    </t>
</templates>